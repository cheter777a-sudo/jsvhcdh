<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Приглашение 💌</title>
  <!-- Подключаем Telegram Web App SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ff9a9e, #fecfef, #a18cd1);
      color: #fff;
      text-align: center;
      padding: 20px;
      overflow: hidden;
    }
    .card {
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      border-radius: 25px;
      padding: 40px 25px;
      max-width: 420px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.2);
      animation: fadeIn 1s ease;
    }
    @keyframes fadeIn { from {opacity:0; transform:translateY(20px);} to {opacity:1; transform:translateY(0);} }
    h1 { font-size: 1.8em; margin-bottom: 15px; }
    p { font-size: 1.1em; line-height: 1.6; margin-bottom: 25px; }
    .buttons { display: flex; flex-direction: column; gap: 15px; }
    button {
      border: none;
      padding: 16px 30px;
      font-size: 1.1em;
      border-radius: 50px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s ease;
    }
    #yesBtn {
      background: #ff4d6d;
      color: white;
      box-shadow: 0 6px 20px rgba(255,77,109,0.5);
    }
    #yesBtn:hover { transform: scale(1.05); }
    #noBtn {
      background: rgba(255,255,255,0.3);
      color: #fff;
      transition: all 0.2s ease;
    }
    .hidden { display: none; }
    #success { animation: pop 0.5s ease; }
    @keyframes pop { 0% {transform:scale(0.8);} 100% {transform:scale(1);} }
    .heart { position: fixed; font-size: 24px; animation: float 4s linear infinite; pointer-events: none; }
    @keyframes float {
      from { transform: translateY(100vh) rotate(0deg); opacity:1; }
      to { transform: translateY(-10vh) rotate(360deg); opacity:0; }
    }
  </style>
</head>
<body>

  <!-- ЭКРАН 1: Приглашение -->
  <div class="card" id="invite">
    <h1>Привет, [Мори] 💕</h1>
    <p>У меня к тебе важный вопрос... <br><br>
       Пойдёшь со мной на свидание? 🌹<br>
       Обещаю: будет вкусно, красиво и весело, особенно картины😊</p>
    <div class="buttons">
      <button id="yesBtn">Да, с удовольствием ❤️</button>
      <button id="noBtn">Нет 🙈</button>
    </div>
  </div>

  <!-- ЭКРАН 2: Успех -->
  <div class="card hidden" id="success">
    <h1>Урааа! 🎉</h1>
    <p>Значит, договорились! 💖<br><br>
       <b>Когда:</b> ещё не знаю<br>
       <b>Где:</b> [Третьяковская Галерея]<br><br>
       Жду с нетерпением 😊🌹</p>
  </div>

  <script>
    const tg = window.Telegram.WebApp;
    tg.expand(); // раскрыть на весь экран
    tg.ready();

    const noBtn = document.getElementById('noBtn');
    const yesBtn = document.getElementById('yesBtn');
    const invite = document.getElementById('invite');
    const success = document.getElementById('success');

    // Кнопка "Нет" убегает при наведении/нажатии 😄
    noBtn.addEventListener('mouseover', moveNo);
    noBtn.addEventListener('touchstart', moveNo);
    noBtn.addEventListener('click', moveNo);

    function moveNo() {
      noBtn.style.position = 'fixed';
      noBtn.style.left = Math.random() * (window.innerWidth - 150) + 'px';
      noBtn.style.top = Math.random() * (window.innerHeight - 80) + 'px';
    }

    // Кнопка "Да"
    yesBtn.addEventListener('click', () => {
      invite.classList.add('hidden');
      success.classList.remove('hidden');
      launchConfetti();

      // Отправляем сигнал боту (если используешь сервер)
      if (tg.initDataUnsafe?.user) {
        tg.sendData(JSON.stringify({ answer: 'yes', user: tg.initDataUnsafe.user.first_name }));
      }
      tg.HapticFeedback.notificationOccurred('success');
    });

    // Простое конфетти из сердечек
    function launchConfetti() {
      const emojis = ['❤️','💖','🌹','✨','💕','🥰'];
      for (let i = 0; i < 30; i++) {
        const el = document.createElement('div');
        el.className = 'heart';
        el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        el.style.left = Math.random() * 100 + 'vw';
        el.style.animationDelay = Math.random() * 3 + 's';
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 6000);
      }
    }
  </script>
</body>
</html>
